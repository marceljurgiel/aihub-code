{
  "name": "aihub-code-app",
  "version": "0.3.0",
  "description": "aihub-code \u2014 interactive OpenTUI line UI over the aihub-code Python bridge",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "bin": {
    "aihub-code-app": "src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run --watch src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-reconciler": "^0.33.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "0.5.6",
    "@opentui/keymap": "0.5.6",
    "@opentui/react": "0.5.6",
    "react": "^19.2.6"
  },
  "overrides": {
    "@opentui/core": "0.5.6"
  }
}
