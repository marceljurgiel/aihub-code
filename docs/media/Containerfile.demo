# aihub-code installed from this checkout, a tiny project with a failing test,
# and an AIhub setup that points at "gpu-box.lan".
FROM aihub-code-vhs-base
USER alex
WORKDIR /home/alex
RUN AIHUB_CODE_SOURCE=/pkg/aihub-code.tar.gz bash /pkg/install.sh </dev/null >/tmp/install.log 2>&1 \
 || (cat /tmp/install.log; exit 1)
COPY --chown=alex:alex seed/shop/ /home/alex/shop/
RUN cd /home/alex/shop && git init -q -b main && git add -A \
 && git -c user.name=alex -c user.email=alex@example.com commit -qm "A tiny shopping cart"
ARG MODEL=gemma4:cloud
# The Ollama server is "gpu-box.lan" in the recording. Memory learning is off,
# so every request in the video is the agent's own. No Ollama update note.
RUN mkdir -p /home/alex/.aihub/cache /home/alex/.aihub/memory \
 && printf 'ollama_api_url: http://gpu-box.lan:11434\ndefault_chat_model: %s\nmemory_enabled: false\n' "$MODEL" > /home/alex/.aihub/config.yaml \
 && printf '{"version": "0.0.0", "checked": %s}' "$(date +%s)" > /home/alex/.aihub/cache/ollama-latest.json \
 && printf '{"theme": "aihub"}\n' > /home/alex/.aihub/aihub-code-settings.json
COPY --chown=alex:alex seed/demo-memory.md /home/alex/.aihub/memory/memory.md
USER root
