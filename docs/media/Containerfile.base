# VHS (terminal recorder) with the demo user "alex" and this checkout packed
# in /pkg. The install tape runs here; Containerfile.demo builds on it.
FROM ghcr.io/charmbracelet/vhs:latest
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      curl ca-certificates git python3 python3-pytest python-is-python3 >/dev/null \
 && rm -rf /var/lib/apt/lists/* && useradd -m -s /bin/bash alex
COPY pkg/ /pkg/
